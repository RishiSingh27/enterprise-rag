# ============================================================
#  Enterprise Knowledge Assistant - environment template
#  Copy to .env and fill in.  NEVER commit .env.
# ============================================================

APP_NAME="Enterprise Knowledge Assistant"
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ---------- Azure AI Foundry : LLM + Embeddings ----------
AZURE_OPENAI_ENDPOINT=https://<your-foundry>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# ---------- Azure AI Document Intelligence ----------
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<your-di>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=<your-key>

# azure = Document Intelligence | local = unstructured/pdfplumber/tesseract
PARSER_BACKEND=azure
ENABLE_MULTIMODAL=true
ENABLE_OCR=true

# ---------- Chunking ----------
TARGET_CHUNK_TOKENS=800
MAX_CHUNK_TOKENS=1000
CHUNK_OVERLAP_TOKENS=120

# ---------- Retrieval ----------
DENSE_TOP_K=20
SPARSE_TOP_K=20
FINAL_TOP_K=5
RRF_K=60
RETRIEVAL_MIN_SCORE=0.35
ENABLE_RERANK=true

# ---------- Generation ----------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# ---------- Storage ----------
DATA_DIR=./data
REGISTRY_URL=sqlite:///./data/registry.db

# ---------- Frontend ----------
BACKEND_URL=http://localhost:8000

# ---------- Corporate network (uncomment if behind TLS inspection) ----------
# REQUESTS_CA_BUNDLE=/path/to/corp-ca.pem
# SSL_CERT_FILE=/path/to/corp-ca.pem
